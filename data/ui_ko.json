    "skill.guardian.Q.name": "\uc804\ubc29 \ubca0\uae30",
    "skill.guardian.Q.short": "\uc804\ubc29\uc758 \uc801\uc744 \ud55c \ubc88\uc5d0 \ubca0\uc5b4 \uacf5\uaca9",
    "skill.guardian.Q.detail": "\uc804\ubc29 \ubd80\ucc44\uaf34 \ubc94\uc704\uc5d0 \ubb3c\ub9ac \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4. \ucd5c\ub300 8\uba85.",
    "skill.guardian.W.name": "\uc218\ud638 \ubc29\ud328",
    "skill.guardian.W.short": "4\ucd08 \ubcf4\ud638\ub9c9 \u00b7 \uc8fc\ubcc0 \uc801 2\ucd08 \ub3c4\ubc1c",
    "skill.guardian.W.detail": "\uc790\uc2e0\uc5d0\uac8c 4\ucd08 \ub3d9\uc548 \ubcf4\ud638\ub9c9\uc744 \uc50c\uc6b0\uace0 \uc8fc\ubcc0 \uc801\uc744 2\ucd08 \ub3d9\uc548 \ub3c4\ubc1c\ud569\ub2c8\ub2e4. \uacf5\uc131\ud3ec\uc640 \ubcf4\uc2a4\ub294 \ub3c4\ubc1c\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
    "skill.guardian.E.name": "\ubc29\ud328 \ub3cc\uc9c4",
    "skill.guardian.E.short": "\ub3cc\uc9c4 \uacf5\uaca9 \u00b7 \uc8fc\ubcc0 \uc801 2\ucd08 \uac10\uc18d",
    "skill.guardian.E.detail": "\uc55e\uc73c\ub85c \ub3cc\uc9c4\ud55c \ub4a4 \uc8fc\ubcc0 \uc801\uc5d0\uac8c \ubb3c\ub9ac \ud53c\ud574\ub97c \uc8fc\uace0 2\ucd08 \ub3d9\uc548 \ub290\ub9ac\uac8c \ub9cc\ub4ed\ub2c8\ub2e4.",
    "skill.guardian.R.name": "\ucda9\uaca9\ud30c",
    "skill.guardian.R.short": "\uc8fc\ubcc0 \uc801\uc5d0\uac8c 8\ud68c \uc5f0\uc18d \uacf5\uaca9",
    "skill.guardian.R.detail": "\uc790\uc2e0\uc744 \ub530\ub77c\ub2e4\ub2c8\ub294 \ucda9\uaca9\ud30c\uac00 \uc8fc\ubcc0 \uc801\uc5d0\uac8c \ubb3c\ub9ac \ud53c\ud574\ub97c 8\ud68c \uc90d\ub2c8\ub2e4. \ubc29\uc5b4 \ud6a8\uacfc\ub294 \uc5c6\uc2b5\ub2c8\ub2e4.",
    "skill.ranger.Q.name": "\uad00\ud1b5 \ud654\uc0b4",
    "skill.ranger.Q.short": "\uc77c\uc9c1\uc120\uc73c\ub85c \ucd5c\ub300 8\uba85 \uad00\ud1b5",
    "skill.ranger.Q.detail": "\uc804\ubc29 \uc77c\uc9c1\uc120\uc5d0 \uc788\ub294 \uc801\uc744 \ucd5c\ub300 8\uba85\uae4c\uc9c0 \uad00\ud1b5\ud574 \ubb3c\ub9ac \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.",
    "skill.ranger.W.name": "\ud3ed\ubc1c \ub36b",
    "skill.ranger.W.short": "\ud3ed\ubc1c \ud53c\ud574 \u00b7 \uc801\uc744 3\ucd08 \ub3d9\uc548 \uac10\uc18d",
    "skill.ranger.W.detail": "\uc801\uc774 \uc811\uadfc\ud558\uba74 \ud3ed\ubc1c\ud558\ub294 \ub36b\uc744 \uc124\uce58\ud569\ub2c8\ub2e4. \ubc94\uc704 \ub0b4 \uc801\uc5d0\uac8c \ubb3c\ub9ac \ud53c\ud574\ub97c \uc8fc\uace0 3\ucd08 \ub3d9\uc548 \ub290\ub9ac\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. \ucd5c\ub300 2\uac1c.",
    "skill.ranger.E.name": "\ud6c4\ubc29 \ub3c4\uc57d",
    "skill.ranger.E.short": "\ub4a4\ub85c \uc774\ub3d9 \u00b7 \uacf5\uaca9 \uc18d\ub3c4 3\ucd08 \uc99d\uac00",
    "skill.ranger.E.detail": "\uc870\uc900 \ubc29\ud5a5\uc758 \ubc18\ub300\ub85c \ub3c4\uc57d\ud569\ub2c8\ub2e4. 3\ucd08 \ub3d9\uc548 \uacf5\uaca9 \uc18d\ub3c4\uac00 25% \uc99d\uac00\ud569\ub2c8\ub2e4.",
    "skill.ranger.R.name": "\ud3ed\ud48d \uc0ac\uaca9",
    "skill.ranger.R.short": "6\ucd08 \ub3d9\uc548 \uae30\ubcf8 \uacf5\uaca9 \uac15\ud654",
    "skill.ranger.R.detail": "6\ucd08 \ub3d9\uc548 \uae30\ubcf8 \uacf5\uaca9\uc5d0 \ucd94\uac00 \ud53c\ud574\uac00 \uc0dd\uae30\uace0 \uc8fc\ubcc0 \uc801 1\uba85\uc5d0\uac8c\ub3c4 \ucd94\uac00 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.",
    "skill.arcanist.Q.name": "\ub9c8\ub825 \ud3ed\ubc1c",
    "skill.arcanist.Q.short": "\uc9c0\uc815\ud55c \ubc94\uc704\uc5d0 \ub9c8\ubc95 \ud53c\ud574",
    "skill.arcanist.Q.detail": "\uc9c0\uc815\ud55c \uc9c0\uc810\uc5d0\uc11c \ud3ed\ubc1c\uc744 \uc77c\uc73c\ucf1c \uc8fc\ubcc0 \uc801\uc5d0\uac8c \ub9c8\ubc95 \ud53c\ud574\ub97c \uc90d\ub2c8\ub2e4.",
    "skill.arcanist.W.name": "\ub9c8\ub825 \ubcf4\ud638\ub9c9",
    "skill.arcanist.W.short": "\uc790\uc2e0\uc5d0\uac8c 4\ucd08 \ub3d9\uc548 \ubcf4\ud638\ub9c9",
    "skill.arcanist.W.detail": "\uc790\uc2e0\uc5d0\uac8c 4\ucd08 \ub3d9\uc548 \ud53c\ud574\ub97c \ud761\uc218\ud558\ub294 \ubcf4\ud638\ub9c9\uc744 \uc50c\uc6c1\ub2c8\ub2e4. \ub9c8\ubc95 \ud53c\ud574\uc5d0\ub9cc \ud55c\uc815\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
    "skill.arcanist.E.name": "\ub9c8\ub825 \uc9c0\ub300",
    "skill.arcanist.E.short": "4\ucd08 \ub3d9\uc548 \ubc94\uc704 \ud53c\ud574\uc640 \uac10\uc18d",
    "skill.arcanist.E.detail": "\uc9c0\uc815\ud55c \uc9c0\uc810\uc5d0 4\ucd08 \ub3d9\uc548 \ub9c8\ubc95 \ud53c\ud574\uc640 \uac10\uc18d\uc744 \uc8fc\ub294 \uc601\uc5ed\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. \uc801\uc744 \ub04c\uc5b4\ub2f9\uae30\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
