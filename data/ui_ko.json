    "help.equipment.prep": "\uc900\ube44 \uc2dc\uac04\uc740 {seconds}\ucd08\uc785\ub2c8\ub2e4. \uc0c1\uc810\uc744 \uc5f4\uba74 \uc2dc\uac04\uc774 \uba48\ucda5\ub2c8\ub2e4.\n\uc900\ube44\uac00 \ub05d\ub0ac\ub2e4\uba74 \ubc14\ub85c \ub2e4\uc74c \uc6e8\uc774\ube0c\ub97c \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
    "help.equipment.first_prep": "\uccab \uc6e8\uc774\ube0c\ub294 \uc804\ud22c \uc2dc\uc791\uc744 \ub204\ub97c \ub54c\uae4c\uc9c0 \uae30\ub2e4\ub9bd\ub2c8\ub2e4.",
    "help.equipment.slots_title": "\uc7a5\ube44 6\uac1c \u00b7 \ubb3c\uc57d 3\uac1c",
    "help.equipment.slots": "\uc7a5\ube44 \ud6a8\uacfc\ub294 \uc601\uc6c5\uc5d0\uac8c\ub9cc \uc801\uc6a9\ub429\ub2c8\ub2e4.\n\ubb3c\uc57d\uc740 \uc7a5\ube44 \uc2ac\ub86f\uc744 \ucc28\uc9c0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
    "help.equipment.recipe_title": "\ubcf4\uc720 \uc7a5\ube44\ub85c \uc870\ud569",
    "help.equipment.recipe": "\ubcf4\uc720 \uc7ac\ub8cc\ub294 \uc870\ud569\uc5d0 \uc0ac\uc6a9\ub418\uace0 \uad6c\ub9e4\uac00\uc5d0\uc11c \ucc28\uac10\ub429\ub2c8\ub2e4.\n\uc5c6\ub294 \uc7ac\ub8cc\uc758 \uac00\uaca9\uc740 \uc790\ub3d9\uc73c\ub85c \ud3ec\ud568\ub429\ub2c8\ub2e4.",
    "help.equipment.unlock": "2\uc6e8\uc774\ube0c \ud074\ub9ac\uc5b4 \ud6c4 2\ub2e8\uacc4, 5\uc6e8\uc774\ube0c \ud074\ub9ac\uc5b4 \ud6c4 3\ub2e8\uacc4 \uc7a5\ube44\ub97c \uc0b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
    "help.equipment.death": "\uc601\uc6c5\uc740 \uc4f0\ub7ec\uc838\ub3c4 \ubd80\ud65c\ud558\uc9c0\ub9cc \uc131\ucc44\ub294 \uacc4\uc18d \uacf5\uaca9\ubc1b\uc2b5\ub2c8\ub2e4.",
    "help.equipment.save": "\uc900\ube44 \ub2e8\uacc4\uc5d0 \uc790\ub3d9 \uc800\uc7a5\ub429\ub2c8\ub2e4. \uc774\uc5b4\ud558\uae30\ub294 \ub9c8\uc9c0\ub9c9 \uc900\ube44 \ub2e8\uacc4\ubd80\ud130 \uc2dc\uc791\ud569\ub2c8\ub2e4.",
