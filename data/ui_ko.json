    "help.support.defenders_title": "AI \uc218\ube44\ubcd1",
    "help.support.defenders": "\ud478\ub978 \uae43\ubc1c\uc758 AI \uc218\ube44\ubcd1\uc774 \uac00\uae4c\uc6b4 \uc801\uc744 \uacf5\uaca9\ud569\ub2c8\ub2e4. \uc4f0\ub7ec\uc9c0\uba74 {respawn_seconds}\ucd08 \ub4a4 \ubcf5\uadc0\ud558\uba70, \uc6e8\uc774\ube0c\uac00 \ub05d\ub098\uba74 \ud68c\ubcf5\ud569\ub2c8\ub2e4.",
    "help.support.camp_title": "\uc120\ud0dd \uc0ac\ub0e5\ud130",
    "help.support.camp": "\uc6e8\uc774\ube0c {waves}, \uc811\uadfc \ud6c4 \uc0ac\ub0e5 \uc2dc\uc791\uc744 \ub204\ub974\uc138\uc694. {seconds}\ucd08 \uc548\uc5d0 {count}\ub9c8\ub9ac \ubaa8\ub450 \ucc98\uce58\ud558\uba74 {gold}\uace8\ub4dc\u00b7\uacbd\ud5d8\uce58 {xp}\ub97c \ud55c \ubc88 \ubc1b\uc2b5\ub2c8\ub2e4. \uac1c\ubcc4 \ucc98\uce58 \ubcf4\uc0c1\uc740 \uc5c6\uc2b5\ub2c8\ub2e4.",
    "help.support.risk_title": "\ubcf8\uc9c4 \uc804\ud22c\ub294 \uacc4\uc18d\ub429\ub2c8\ub2e4",
